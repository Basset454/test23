# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BLOB_READ_WRITE_TOKEN: Token from Vercel Blob store (test23-blob).
# Automatically provided in Vercel when you attach a Blob store to your project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Neon Postgres Database URL: Provided automatically by Vercel when Neon integration is attached.
# Format: postgres://[user]:[password]@[host]/[database]?sslmode=require
POSTGRES_URL="postgres://..."
DATABASE_URL="postgres://..."

# ADMIN_PASSWORD: Password for /admin login (defaults to trust2026 if not set).
ADMIN_PASSWORD="trust2026"
